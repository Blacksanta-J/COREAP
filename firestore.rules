rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string;
    }

    function isBue() {
      return signedIn()
        && request.auth.token.email.matches('.*@bue\\.edu\\.ar$');
    }

    function userDocPath(email) {
      return /databases/$(database)/documents/users/$(email);
    }

    function userData() {
      return get(userDocPath(request.auth.token.email)).data;
    }

    function hasAdminRole() {
      let data = userData();
      return data.role == 'admin'
        || (data.roles is list && 'admin' in data.roles);
    }

    function isAdmin() {
      return isBue()
        && exists(userDocPath(request.auth.token.email))
        && hasAdminRole()
        && userData().active != false;
    }

    function isSeedAdmin() {
      return isBue()
        && request.auth.token.email == 'jonathanalejandro.perez@bue.edu.ar';
    }

    match /users/{userEmail} {
      allow read: if isBue();
      allow create: if isAdmin() || isSeedAdmin();
      allow update, delete: if isAdmin() || isSeedAdmin();
    }

    match /_meta/{docId} {
      allow read, write: if isSeedAdmin() || isAdmin();
    }
  }
}
