rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function isBue() {
      return signedIn()
        && authEmail().matches('.*@bue\\.edu\\.ar$');
    }

    function userDocPath(email) {
      return /databases/$(database)/documents/users/$(email);
    }

    function userData() {
      return get(userDocPath(authEmail())).data;
    }

    function hasAdminRole() {
      let data = userData();
      return data.role == 'admin'
        || (data.roles is list && 'admin' in data.roles);
    }

    function isAdmin() {
      return isBue()
        && exists(userDocPath(authEmail()))
        && hasAdminRole()
        && userData().active != false;
    }

    function isSeedAdmin() {
      return isBue()
        && authEmail() == 'jonathanalejandro.perez@bue.edu.ar';
    }

    match /users/{userEmail} {
      /* Cualquier @bue autenticado lee su propio doc; el listado es solo admin */
      allow get: if isBue() && (
        userEmail == authEmail() || isAdmin() || isSeedAdmin()
      );
      allow list: if isAdmin() || isSeedAdmin();
      allow create: if isAdmin() || isSeedAdmin();
      allow update, delete: if isAdmin() || isSeedAdmin();
    }

    match /_meta/{docId} {
      allow read, write: if isSeedAdmin() || isAdmin();
    }

    /* Matriz rol → módulos: todos @bue leen; solo Admin escribe */
    match /config/{docId} {
      allow get, list: if isBue();
      allow create, update, delete: if isAdmin() || isSeedAdmin();
    }

    function hasVacantesRole() {
      let data = userData();
      return data.role == 'admin'
        || data.role == 'concursos'
        || data.role == 'listados'
        || (data.roles is list && (
          'admin' in data.roles
          || 'concursos' in data.roles
          || 'listados' in data.roles
        ));
    }

    function canVacantes() {
      return isSeedAdmin() || (
        isBue()
        && exists(userDocPath(authEmail()))
        && userData().active != false
        && hasVacantesRole()
      );
    }

    /* Cargas mensuales de Vacantes Provisorias */
    match /vacantes_provisorias_cargas/{cargaId} {
      allow read, create, update, delete: if canVacantes();
    }
    match /vacantes_provisorias_chunks/{chunkId} {
      allow read, create, update, delete: if canVacantes();
    }

    /* Log de ejecuciones de procesadores: escritura autenticada @bue; lectura solo admin */
    match /process_logs/{logId} {
      allow create: if isBue()
        && exists(userDocPath(authEmail()))
        && userData().active != false
        && request.resource.data.email == authEmail()
        && request.resource.data.keys().hasAll([
          'createdAt', 'email', 'module', 'procesador'
        ]);
      allow read: if isAdmin() || isSeedAdmin();
      allow update: if false;
      allow delete: if isAdmin() || isSeedAdmin();
    }
  }
}
